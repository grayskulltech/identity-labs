{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grayskull.tech/castleops/contract/v1/authz-request.schema.json",
  "title": "Authorization request handed to PolicyDecisionPoint",
  "type": "object",
  "required": ["request_id", "now", "principal", "tool", "args", "device", "presence_verified", "policy"],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "now": { "type": "string", "format": "date-time" },
    "principal": { "$ref": "principal-assertion.schema.json" },
    "tool": {
      "type": "object",
      "required": ["id", "version", "kind", "domain"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer" },
        "kind": { "enum": ["read", "write", "elevate"] },
        "domain": { "type": "string" }
      }
    },
    "args": { "type": "object", "description": "Already validated against the tool's argument schema. Only policy_hints fields are guaranteed present." },
    "args_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "device": { "$ref": "posture-record.schema.json" },
    "presence_verified": { "type": "boolean", "description": "True when the request was signed by the biometry-gated presence key." },
    "policy": {
      "type": "object",
      "required": ["minimum_os", "attestation_max_age_seconds", "checkin_max_age_seconds"],
      "additionalProperties": false,
      "properties": {
        "minimum_os": { "type": "string" },
        "attestation_max_age_seconds": { "type": "integer" },
        "checkin_max_age_seconds": { "type": "integer" }
      }
    }
  }
}
